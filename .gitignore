
# ==========================================
# LookBook Smart Pricing AI
# Root .gitignore
# ==========================================

# Node.js dependencies
node_modules/
**/node_modules/

# Environment variables and secrets
.env
.env.*
!.env.example
!**/.env.example

# Build output
dist/
build/
coverage/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Temporary files
tmp/
temp/
*.tmp

# Operating system
.DS_Store
Thumbs.db
Desktop.ini

# Editor files
.vscode/*
!.vscode/extensions.json
.idea/

# Local database files and backups
*.sqlite
*.sqlite3
*.db
*.dump
*.backup
package-lock.json
